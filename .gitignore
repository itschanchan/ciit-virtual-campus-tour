# CIIT Virtual Campus Tour - .gitignore

# Dependencies
node_modules/

# Build outputs
dist/
build/
*.log

# Environment files (secrets - must never be committed)
.env
.env.local
.env.*.local

# Backend client REST client file (secrets)
apps/backend/client.rest

# Spec Kit feature state (generated per feature)
.specify/feature.json

# Spec Kit extension local config (machine-local)
.specify/extensions/example/local-config.yml

# OS
.DS_Store
Thumbs.db
*.tmp
*.swp

# Editor
.vscode/
.idea/

# Test coverage
coverage/
.vitest/
